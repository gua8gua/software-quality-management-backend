# =============================================================================
# RAG Center — 环境配置
# 复制此文件为 .env 并修改
# =============================================================================

# --- 应用基础 ---
APP_ENV=local
API_PORT=8000

# --- 日志 ---
LOG_LEVEL=INFO          # DEBUG / INFO / WARNING / ERROR
LOG_DIR=logs            # 容器内日志目录（相对 /app）
LOG_HOST_DIR=./logs     # 日志在宿主机的存储目录（Docker Compose 挂载到容器内 LOG_DIR）
LOG_TO_FILE=true        # 是否写入文件（控制台始终输出）
LOG_ROTATION=size       # size=按大小滚动 | time=按天滚动
LOG_MAX_BYTES=10485760  # 单个日志文件上限（默认 10MB）
LOG_BACKUP_COUNT=10     # 保留的历史日志文件数
# LOG_USE_COLOR=        # 留空=TTY 自动启用彩色；true/false 强制

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=software_quality_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 本地开发直连（Docker Compose 启动时自动覆盖为容器内地址）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/software_quality_management

# --- Embedding 模型（OpenAI 兼容接口） ---
# 阿里云 DashScope（Qwen）:  https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI 官方:                https://api.openai.com/v1
# Ollama 本地:                http://localhost:11434/v1
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
MODEL_TIMEOUT_SECONDS=30

# --- 向量存储 & 分块 ---
VECTOR_STORE=pgvector
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# --- 通用大模型（OpenAI 兼容接口） ---
# 重排、query rewrite、意图识别、评测辅助生成等能力统一通过该接口调用大模型。
# DeepSeek:            https://api.deepseek.com/v1            (LLM_MODEL=deepseek-chat)
# 阿里云百炼 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1 (LLM_MODEL=qwen-plus)
# OpenAI 官方:          https://api.openai.com/v1
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# --- 重排（rerank） ---
RERANK_ENABLED=false          # 全局是否启用大模型重排
RERANK_PROVIDER=llm           # llm=通过通用 LLMProvider 打分 | noop=不重排
RERANK_TOP_N=5                # 重排后最终返回数量
RERANK_MAX_CANDIDATES=20      # 最多送入大模型的候选 chunk 数
RERANK_CHUNK_MAX_CHARS=1000   # 每个 chunk 送入大模型前的最大字符数
RERANK_TEMPERATURE=0.0        # 重排模型温度，建议 0.0

# --- TLR（默认 Python 检索；每次运行可选择原版 LiSSA Java 检索） ---
TLR_RUN_TIMEOUT_SECONDS=1800
TLR_MAX_ELEMENTS=5000
TLR_MAX_CANDIDATES=20000
TLR_MAX_COMPARISONS=2000000
TLR_RETRIEVAL_TIMEOUT_SECONDS=120
TLR_LISSA_JAR=vendor/lissa/LiSSA-RATLR-V2/lissa/target/ratlr-0.2.0-SNAPSHOT-jar-with-dependencies.jar
TLR_LISSA_BRIDGE_DIR=artifacts/lissa/bridge
TLR_JAVA_COMMAND=java

