APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/software_quality_management

LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://127.0.0.1:18000/v1
LLM_API_KEY=
LLM_MODEL=qwen35-9b
LLM_MODEL_VERSION=
LLM_TIMEOUT_SECONDS=60
LLM_NATIVE_JSON_SCHEMA=false
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REVISION=main
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=8
